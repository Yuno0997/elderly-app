PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-64-char-random-hex-string
APP_ENV=development
ALLOW_DEMO_SEED=true
FIRST_ADMIN_BOOTSTRAP_KEY=change-me-before-production
UNISMS_API_SECRET=
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_DB_SECRET=your-firebase-database-secret
FIREBASE_RTDB_PREFIX=/safeband
BAND_DEVICE_ID=SAFEBAND-001
# Comma-separated origins allowed by CORS (no trailing slash)
CORS_ORIGINS=http://localhost:3000
# Optional: override uploads directory
# UPLOADS_DIR=./server/data/uploads
